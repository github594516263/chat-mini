# 复制成 .env 后被 docker compose 读取（注意：不是 .env.local，那个是本地 dev 用的）
#
#   cp .env.docker.example .env
#   chmod 600 .env
#
# .env 已经在 .gitignore 里，不会被提交；.dockerignore 也会挡住它，不会进镜像。

# ---------------------------------------------------------------- 数据库
DB_NAME=chat_mini
DB_USER=chat_app
# 应用账号密码（随便生成一个强的，别用你能在其他地方复用的密码）
DB_PASSWORD=
# root 密码，只在容器内用，从不对外
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------- 加密
# 用来加密用户在「设置 → 模型」里填的 API Key，必须是 32 字节随机数的 base64：
#   openssl rand -base64 32
# ⚠️ 生成一次存好。换掉它 = 所有已保存的用户密钥解不开，用户得重新填。
MODEL_SECRET_KEY=

# ---------------------------------------------------------------- 模型
# 官方：直接填 key，BASE_URL 留空
# 中转站：填 key + DEEPSEEK_BASE_URL=https://你的域名（或 /v1 结尾）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# 可选，留空则自动选第一条已配置的模型
DEFAULT_MODEL=
