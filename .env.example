# 复制成 .env.local 后填自己的 key；一家都不配则自动走内置假数据流
#
# 模型目录在 src/lib/models.ts，这里只配 provider 的凭据。
# 只配其中一家时，其余分组会显示「未配置」且不可选 —— 不会静默走假数据流。
DEEPSEEK_API_KEY=
# 可选：中转站/自建网关地址。官方留空即可
#   留空                    → https://api.deepseek.com
#   https://xxx.com         → https://xxx.com/chat/completions
#   https://xxx.com/v1      → https://xxx.com/v1/chat/completions
DEEPSEEK_BASE_URL=
# 可选：默认模型的公开 id（见 models.ts，如 deepseek:v4-pro）
# 留空则自动选第一条已配置的模型
DEFAULT_MODEL=
# 兼容旧配置：deepseek-chat / deepseek-reasoner，用来决定默认落在哪一条目录项
DEEPSEEK_MODEL=deepseek-chat

# --- 其他 OpenAI 兼容网关 ---
# 不填就显示「未配置」；填了 key 但没填 base URL 也算未配置（不知道往哪打）
STARLINK_API_KEY=
STARLINK_BASE_URL=
DEVPOOL_API_KEY=
DEVPOOL_BASE_URL=
FATCAT_API_KEY=
FATCAT_BASE_URL=

# --- 账户级模型配置 ---
# 用于加密用户自己填的 API Key。必须是 32 字节随机数的 base64（生成一次，别丢）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 换掉它会导致已保存的模型密钥无法解密，需要让用户重新填。
MODEL_SECRET_KEY=
# 默认拒绝把模型 API 地址指向 localhost / 内网（防 SSRF）。
# 只有确实要连本地网关时才改成 true。
ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# --- MySQL ---
# 应用账号只有 SELECT/INSERT/UPDATE/DELETE，没有建表权限。
# 建表用 root 执行一次：mysql -u root -p chat_mini < scripts/schema.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chat_app
DB_PASSWORD=
DB_NAME=chat_mini

# --- 注册开关 ---
# false = /api/auth/register 直接 403，只有你能建号（脚本建号见 README）
ALLOW_REGISTER=false
