# 复制成 .env.local 后填自己的 key；不填则自动走内置假数据流
DEEPSEEK_API_KEY=
# 可选：中转站/自建网关地址。官方留空即可
#   留空                    → https://api.deepseek.com
#   https://xxx.com         → https://xxx.com/chat/completions
#   https://xxx.com/v1      → https://xxx.com/v1/chat/completions
DEEPSEEK_BASE_URL=
# 可选：deepseek-chat（默认）或 deepseek-reasoner（会吐 think_delta）
DEEPSEEK_MODEL=deepseek-chat
